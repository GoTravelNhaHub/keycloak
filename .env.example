# Copy to .env. Never commit .env.

# --- Keycloak server ---------------------------------------------------------
# First-boot master-realm admin. Used once to create the admin account; change the
# password in the console afterwards (or create a personal admin and delete this one).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# Public base URL of Keycloak. Prod: https://auth.gotravelnha.com
KC_HOSTNAME=http://localhost:8080

KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-db
# Only needed for an external DB (e.g. Neon direct host):
# KC_DB_URL=jdbc:postgresql://ep-xxx.ap-southeast-1.aws.neon.tech/keycloak?sslmode=require

# --- Realm import placeholders (realm/gotravelnha-realm.json) ------------------
# Read ONLY on first import of the realm. Later changes go through the admin console
# or scripts/kcadm.sh.

# App origins, no trailing slash.
GTN_WEB_URL=http://localhost:3000
# GoTravelNha API (runs the login, redirect URI ${GTN_API_URL}/auth/callback) and admin app.
# Prod: https://api.gotravelnha.com and https://admin.gotravelnha.com
GTN_API_URL=http://localhost:3002
GTN_ADMIN_URL=http://localhost:3001
FH_WEB_URL=http://localhost:5173

# Confidential client secret for the Nuxt server (gotravelnha-web). `openssl rand -hex 32`
GTN_WEB_CLIENT_SECRET=change-me-gtn-web-secret

# Service-account client for backends/scripts that manage users. `openssl rand -hex 32`
IAM_ADMIN_CLIENT_SECRET=change-me-iam-admin-secret

# SMTP for verify-email / reset-password mails (Resend works: host smtp.resend.com, port 465, user "resend").
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_FROM=noreply@gotravelnha.com
SMTP_USER=resend
SMTP_PASSWORD=
